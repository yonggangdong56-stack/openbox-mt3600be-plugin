#!/bin/sh
# Open-Box standalone installer for GL.iNet MT3600BE / ImmortalWrt 25.12 ARM64.
# This is NOT embedded in firmware. It downloads and installs the official Open-Box bundle on demand.
set -eu
umask 022
[ "$(id -u)" = 0 ] || { echo "请以 root 运行" >&2; exit 1; }
[ -r /etc/openwrt_release ] || { echo "仅支持 OpenWrt/ImmortalWrt" >&2; exit 1; }
[ "$(uname -m)" = aarch64 ] || { echo "本插件仅支持 ARM64" >&2; exit 1; }
command -v curl >/dev/null 2>&1 || { echo "缺少 curl，请先安装 curl" >&2; exit 1; }
command -v sha256sum >/dev/null 2>&1 || { echo "缺少 sha256sum，请先安装 coreutils-sha256sum" >&2; exit 1; }
TARGET=/opt
for p in /mnt/sda1 /mnt/mmcblk0p1 /mnt/usb /media/sda1; do
  if [ -d "$p" ] && [ "$(df -Pk "$p" | awk 'NR==2{print $4}')" -ge 512000 ]; then TARGET="$p/openbox-opt"; break; fi
done
mkdir -p "$TARGET"
FREE=$(df -Pk "$TARGET" | awk 'NR==2{print $4}')
[ "$FREE" -ge 512000 ] || { echo "可用空间不足 512MB；请挂载 USB 存储后再安装" >&2; exit 1; }
if [ "$TARGET" != /opt ]; then
  mkdir -p /opt
  if [ -e /opt/open-box ] && [ ! -L /opt/open-box ]; then echo "/opt/open-box 已存在且不是软链接" >&2; exit 1; fi
  [ -L /opt/open-box ] || ln -s "$TARGET" /opt/open-box
fi
ASSET=open-box-v0.1.202-linux-arm64.tar.gz
TMP="$TARGET/.openbox-download.$$"
mkdir -p "$TMP"
trap 'rm -rf "$TMP"' EXIT
curl -fL --connect-timeout 15 -o "$TMP/$ASSET" "https://github.com/liandu2024/Open-Box/releases/download/v0.1.202/$ASSET"
curl -fL --connect-timeout 15 -o "$TMP/$ASSET.sha256" "https://github.com/liandu2024/Open-Box/releases/download/v0.1.202/$ASSET.sha256"
(cd "$TMP" && sha256sum -c "$ASSET.sha256")
mkdir -p /opt/open-box
tar -xzf "$TMP/$ASSET" -C /opt/open-box
chown -R 0:0 /opt/open-box
chmod +x /opt/open-box/bin/sing-box /opt/open-box/node/bin/node 2>/dev/null || true
cp /opt/open-box/openwrt/initd/openbox /etc/init.d/openbox
cp /opt/open-box/openwrt/initd/openbox-panel /etc/init.d/openbox-panel
chmod +x /etc/init.d/openbox /etc/init.d/openbox-panel
/etc/init.d/openbox-panel enable
/etc/init.d/openbox enable
/etc/init.d/openbox-panel start
IP=$(uci -q get network.lan.ipaddr 2>/dev/null || echo 192.168.8.1)
echo "Open-Box 安装完成：http://$IP:2026"
echo "首次打开面板请设置密码。OpenClash 配置未被修改。"
